<footer style="background:#070d1a; color:#64748b; padding:30px 6%; border-top:1px solid var(--card-border); text-align:center; font-size:13px; margin-top:60px;">
    EduConnect University — FSDM & Technologies (2026-2027)
</footer>

<script>
    function switchView(viewName) {
        document.querySelectorAll('.page-view').forEach(v => v.classList.remove('active-view'));
        document.getElementById('view-' + viewName).classList.add('active-view');
        window.scrollTo(0, 0);
    }

    const deptList = [
        {
            key: 'math',
            job: "Devenez mathématicien",
            title: "Département de Mathématiques",
            desc: "Analyse avancée, algèbre, modélisation et structures algébriques.",
            sub: ["SMA", "SMI", "Modélisation", "Statistiques"],
            img: "https://i.pinimg.com/736x/dd/ae/af/ddaeaff76ac2ddcb40fc6fc75883b121.jpg",
            anim: "anim-rotate"
        },
        {
            key: 'pc',
            job: "Devenez chimiste & physicien",
            title: "Département de Physique-Chimie",
            desc: "Mécanique quantique, optique, thermodynamique et chimie organique.",
            sub: ["SMP", "SMC", "Énergétique", "Matériaux"],
            img: "https://i.pinimg.com/736x/c2/49/cb/c249cb422cde59ae29b73db048cfc028.jpg",
            anim: "anim-zoom"
        },
        {
            key: 'info',
            job: "Devenez informaticien",
            title: "Département d'Informatique & IA",
            desc: "Algorithmique, bases de données, architectures logicielles et intelligence artificielle.",
            sub: ["Master Info & Télécom", "Master DSI / Big Data", "Génie Logiciel", "Cyber sécurité"],
            // Image mise à jour ici également pour le slider dynamique
            img: "https://i.pinimg.com/736x/db/d2/ce/dbd2cebc9c2222d69f187108d13122d1.jpg",
            anim: "anim-pan"
        },
        {
            key: 'bio',
            job: "Devenez biologiste",
            title: "Département de Biologie & SVT",
            desc: "Génétique, biologie cellulaire, biochimie et écologie appliquée.",
            sub: ["SVT", "Biochimie", "Génétique", "Ecologie"],
            img: "https://i.pinimg.com/736x/77/a1/1d/77a11d0e9c3073bc84f5a3ea1e3d7077.jpg",
            anim: "anim-rotate"
        },
        {
            key: 'geo',
            job: "Devenez géologue",
            title: "Département de Géologie",
            desc: "Tectonique, minéralogie, cartographie 3D et ressources en eau.",
            sub: ["Stu", "Hydrogéologie", "Géophysique", "Ressources Minérales"],
            img: "https://i.pinimg.com/1200x/95/5e/92/955e92512b01b2f0dddaf292333ab213.jpg",
            anim: "anim-zoom"
        }
    ];

    let currentIndex = 0;
    const jobElement = document.getElementById('job-title');
    const imgElement = document.getElementById('dept-img');
    const subFilieresContainer = document.getElementById('sub-filieres');

    function updateDisplay(index) {
        currentIndex = index;
        const currentData = deptList[currentIndex];

        jobElement.classList.add('fade-out');
        
        setTimeout(() => {
            jobElement.innerText = currentData.job;
            jobElement.classList.remove('fade-out');
            jobElement.classList.add('fade-in');

            document.getElementById('dept-title').innerText = currentData.title;
            document.getElementById('dept-desc').innerText = currentData.desc;
            
            subFilieresContainer.innerHTML = currentData.sub.map(s => `<span class="sub-filiere-badge">${s}</span>`).join('');

            imgElement.src = currentData.img;
            imgElement.className = currentData.anim;

            const badges = document.querySelectorAll('.badge-tag');
            badges.forEach((b, i) => {
                if (i === currentIndex) b.classList.add('active');
                else b.classList.remove('active');
            });
        }, 300);
    }

    let autoRotate = setInterval(() => {
        let nextIndex = (currentIndex + 1) % deptList.length;
        updateDisplay(nextIndex);
    }, 3000);

    function selectDept(key, index) {
        clearInterval(autoRotate);
        updateDisplay(index);
        autoRotate = setInterval(() => {
            let nextIndex = (currentIndex + 1) % deptList.length;
            updateDisplay(nextIndex);
        }, 3000);
    }
</script>

{% endblock %}